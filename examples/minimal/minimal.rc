// Resource script for minimal.exe
// Embeds the application manifest for Windows Common Controls v6

#include <windows.h>

// Manifest resource
1 RT_MANIFEST "minimal.manifest"

// Application icon (if you add one later, uncomment and set path)
// IDI_APPLICATION ICON "icon.ico"

// Version information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "kwxGO Project"
            VALUE "FileDescription",  "kwxGO Minimal Example Application"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "minimal"
            VALUE "LegalCopyright",   "Copyright (C) 2026"
            VALUE "OriginalFilename", "minimal.exe"
            VALUE "ProductName",      "kwxGO"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
