# ###################### Static Archive Merger ######################
#
# Concatenates several static archives into a single archive. Runs in script mode:
#
#   cmake -DOUT_ARCHIVE=<path> -DIN_ARCHIVES=<a;b;c> -DAR_TOOL=<llvm-ar|ar> \
#         -P cmake/MergeArchives.cmake
#
# Extraction + repack is used instead of feeding every input archive straight to
# `ar rcs`: different wxWidgets archives hold identically named members (nearly
# all of them contain their own string.o), and `ar` keeps only one member per
# name, so a naive repack silently drops objects. Every extracted member is
# therefore renamed with an a<N>_ prefix before it is added back. Member-level
# granularity is preserved, so the linker still pulls only what it needs.

foreach(_required OUT_ARCHIVE IN_ARCHIVES AR_TOOL)
    if(NOT DEFINED ${_required})
        message(FATAL_ERROR "MergeArchives: -D${_required}=<...> is required")
    endif()
endforeach()

get_filename_component(_out_dir ${OUT_ARCHIVE} DIRECTORY)
file(MAKE_DIRECTORY ${_out_dir})
# Remove first so repeated runs are idempotent instead of growing the archive.
file(REMOVE ${OUT_ARCHIVE})

set(_work_dir ${_out_dir}/kwxall-merge)
file(REMOVE_RECURSE ${_work_dir})
file(MAKE_DIRECTORY ${_work_dir})

set(_members "")
set(_archive_index 0)
foreach(_archive IN LISTS IN_ARCHIVES)
    if(NOT EXISTS ${_archive})
        message(FATAL_ERROR "MergeArchives: input archive not found: ${_archive}")
    endif()

    set(_extract_dir ${_work_dir}/a${_archive_index})
    file(MAKE_DIRECTORY ${_extract_dir})
    execute_process(
        COMMAND ${AR_TOOL} x ${_archive}
        WORKING_DIRECTORY ${_extract_dir}
        RESULT_VARIABLE _ar_result
        OUTPUT_VARIABLE _ar_stdout
        ERROR_VARIABLE  _ar_stderr
    )
    if(NOT _ar_result EQUAL 0)
        message(FATAL_ERROR
            "MergeArchives: '${AR_TOOL} x ${_archive}' failed (${_ar_result}): ${_ar_stderr}")
    endif()

    file(GLOB _extracted ${_extract_dir}/*)
    foreach(_member IN LISTS _extracted)
        get_filename_component(_member_name ${_member} NAME)
        if(_member_name MATCHES "^(/|__\\.SYMDEF)")
            # Archive symbol tables are regenerated by 'ar s'; repacking one as a
            # regular member would corrupt the output archive.
            file(REMOVE ${_member})
            continue()
        endif()
        set(_prefixed ${_extract_dir}/a${_archive_index}_${_member_name})
        file(RENAME ${_member} ${_prefixed})
        list(APPEND _members ${_prefixed})
    endforeach()
    math(EXPR _archive_index "${_archive_index} + 1")
endforeach()

list(LENGTH _members _member_count)
if(_member_count EQUAL 0)
    message(FATAL_ERROR "MergeArchives: no members extracted from: ${IN_ARCHIVES}")
endif()

# A Windows process command line is capped at 32 KB, so members are added in
# chunks rather than in one `ar` call with thousands of paths.
set(_chunk_size 100)
set(_offset 0)
while(_offset LESS _member_count)
    math(EXPR _last "${_offset} + ${_chunk_size} - 1")
    if(_last GREATER_EQUAL _member_count)
        math(EXPR _last "${_member_count} - 1")
    endif()

    set(_chunk "")
    set(_index ${_offset})
    while(_index LESS_EQUAL _last)
        list(GET _members ${_index} _member)
        list(APPEND _chunk ${_member})
        math(EXPR _index "${_index} + 1")
    endwhile()

    execute_process(
        COMMAND ${AR_TOOL} rcs ${OUT_ARCHIVE} ${_chunk}
        RESULT_VARIABLE _ar_result
        OUTPUT_VARIABLE _ar_stdout
        ERROR_VARIABLE  _ar_stderr
    )
    if(NOT _ar_result EQUAL 0)
        message(FATAL_ERROR
            "MergeArchives: '${AR_TOOL} rcs ${OUT_ARCHIVE}' failed (${_ar_result}): ${_ar_stderr}")
    endif()
    math(EXPR _offset "${_offset} + ${_chunk_size}")
endwhile()

file(SIZE ${OUT_ARCHIVE} _out_size)
math(EXPR _out_mb "${_out_size} / 1048576")
message(STATUS "MergeArchives: ${OUT_ARCHIVE}")
message(STATUS "  members from: ${_archive_index} archives")
message(STATUS "  members:      ${_member_count}")
message(STATUS "  size:         ${_out_mb} MB (${_out_size} bytes)")

file(REMOVE_RECURSE ${_work_dir})
