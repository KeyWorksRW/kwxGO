// Resource script for combo.exe
// Embeds the application manifest for Windows Common Controls v6. Without it
// wxApp::Initialize() displays a "doesn't use a correct manifest" warning box
// and every wxWidgets control falls back to the pre-XP (comctl32 v5) look.
//
// Compiled by windres into combo_windows.syso, which `go build` links
// automatically. The _windows suffix keeps it out of macOS/Linux builds.

#include <windows.h>

// Manifest resource
1 RT_MANIFEST "combo.manifest"

// Version information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "kwxGO Project"
            VALUE "FileDescription",  "kwxGO Combo Sample"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "combo"
            VALUE "LegalCopyright",   "Copyright (C) 2026"
            VALUE "OriginalFilename", "combo.exe"
            VALUE "ProductName",      "kwxGO"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
