// Resource script for widgets.exe
// Embeds the Common Controls v6 application manifest and version information.
// Compiled by windres into widgets_windows.syso, which `go build` links
// automatically. The _windows suffix keeps it out of macOS/Linux builds.

#include <windows.h>

// Manifest resource
1 RT_MANIFEST "widgets.manifest"

// Application icon: loaded at runtime from the sample SVG, so no ICON resource here.

// Version information
VS_VERSION_INFO VERSIONINFO
 FILEVERSION     1,0,0,0
 PRODUCTVERSION  1,0,0,0
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "kwxGO Project"
            VALUE "FileDescription",  "kwxGO Widgets Sample"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "widgets"
            VALUE "LegalCopyright",   "Copyright (C) 2026"
            VALUE "OriginalFilename", "widgets.exe"
            VALUE "ProductName",      "kwxGO"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
